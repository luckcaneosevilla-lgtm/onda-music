# Copia a .env. El servidor lo lee al arrancar; las variables del proceso prevalecen.
YOUTUBE_API_KEY=
YOUTUBE_REGION=ES
# La reproducción actual no usa la clave de YouTube ni iframes.
PIPED_API_URL=http://127.0.0.1:8080
PIPED_PROXY_URL=http://127.0.0.1:8081
AUDIUS_API_URL=https://api.audius.co
ALLOW_YOUTUBE_EXTERNAL=0
# Generar con python scripts/setup_piped.py (no usar una contraseña predeterminada).
PIPED_DB_PASSWORD=
ONDA_DATA=./data
# Base de datos en la nube (Turso). Si están vacías se usa data/onda.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Activar únicamente detrás de HTTPS:
ONDA_SECURE_COOKIE=0
# Caché compartida: mismo valor SOLO en réplicas que comparten IP pública de salida.
# Vacío = aislamiento por hostname (seguro ante salidas de red distintas).
IVOX_AUDIO_CACHE_SCOPE=
# Desactivar una optimización con 0 para diagnosticar un cambio del proveedor.
IVOX_YTDLP_FAST=1
IVOX_AUDIO_PREFETCH=1
# Tiempo de espera por peticion Audius (segundos); coincidencias en memoria 30 min.
IVOX_AUDIUS_TIMEOUT=1.5
